, 199, 0.35);\n}\n\n.class-cohort-pill.unassigned {\n  border-color: rgba(239, 68, 68, 0.3);\n  color: #dc2626;\n}\n\n.class-cohort-pill.unassigned.active {\n  background: #dc2626;\n  color: #ffffff;\n  border-color: #dc2626;\n}\n\n.class-groups-cards-matrix {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));\n  gap: 16px;\n}\n\n.class-group-card {\n  background: #ffffff;\n  border: 1px solid #e2e8f0;\n  border-radius: 12px;\n  padding: 16px;\n  cursor: pointer;\n  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);\n}\n\n.class-group-card:hover {\n  transform: translateY(-3px);\n  border-color: #93c5fd;\n  box-shadow: 0 8px 20px rgba(37, 99, 235, 0.1);\n}\n\n.class-group-card.selected {\n  border: 2px solid #2563eb;\n  background: #eff6ff;\n  box-shadow: 0 0 16px rgba(37, 99, 235, 0.15);\n}\n\n.class-card-top {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.class-grade-badge {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.grade-name {\n  font-size: 15px;\n  font-weight: 800;\n  color: #0f172a;\n}\n\n.section-pill {\n  font-size: 11px;\n  font-weight: 700;\n  padding: 2px 8px;\n  border-radius: 6px;\n  background: rgba(59, 130, 246, 0.18);\n  color: #60a5fa;\n  border: 1px solid rgba(59, 130, 246, 0.3);\n  text-transform: uppercase;\n}\n\n.class-card-settings-btn {\n  width: 28px;\n  height: 28px;\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid var(--border-color);\n  color: var(--text-muted);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.class-card-settings-btn:hover {\n  background: rgba(56, 189, 248, 0.15);\n  color: #38bdf8;\n  border-color: rgba(56, 189, 248, 0.4);\n}\n\n.class-card-teacher-row {\n  display: flex;\n  align-items: center;\n  gap: 10