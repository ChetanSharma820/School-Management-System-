\n  margin: 12px 0 16px;\n}\n\n/* 2. Student Details Popup & Context */\n.student-details-popup {\n  max-width: 680px;\n}\n\n.student-context-card {\n  background: rgba(30, 41, 59, 0.55);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 12px;\n  padding: 14px 18px;\n  margin-bottom: 16px;\n}\n\n.context-row {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 8px;\n  flex-wrap: wrap;\n  font-size: 13px;\n}\n\n.context-row:last-child {\n  margin-bottom: 0;\n}\n\n/* 3. Student Roster Sorting & Filters */\n.roster-controls-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  flex-wrap: wrap;\n  margin-bottom: 16px;\n}\n\n.sort-group-box {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  background: rgba(15, 23, 42, 0.75);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  padding: 6px 12px;\n  border-radius: 10px;\n}\n\n.sort-group-box select {\n  background: transparent;\n  border: none;\n  color: #f8fafc;\n  font-size: 13px;\n  font-weight: 600;\n  outline: none;\n  cursor: pointer;\n}\n\n.sort-group-box select option {\n  background: #0f172a;\n  color: #f8fafc;\n}\n\n.badge-attendance-alert {\n  background: rgba(239, 68, 68, 0.15);\n  color: #f87171;\n  border: 1px solid rgba(239, 68, 68, 0.35);\n  font-weight: 700;\n}\n\n.badge-attendance-good {\n  background: rgba(16, 185, 129, 0.15);\n  color: #34d399;\n  border: 1px solid rgba(16, 185, 129, 0.35);\n  font-weight: 600;\n}\n\n.btn-view-details {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  background: rgba(56, 189, 248, 0.1);\n  border: 1px solid rgba(56, 189, 248, 0.3);\n  color: #38bdf8;\n  padding: 6px 12px;\n  border-radius: 8px;\n  font-size: 12px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.btn-view-details:hover {\n  background: rgba(56, 189, 248, 0.2);\n  border-color: #38bdf8;\n}\n\n/* 4. Teacher Self-Attendance & Timecard */\n.timecard-terminal-banner {\n  background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(15, 23, 42, 0.8) 100%);\n  border: 1px solid rgba(16, 185, 129, 0.3);\n  border-radius: 16px;\n  padding: 24px 28px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  margin-bottom: 24px;\n  flex-wrap: wrap;\n}\n\n.clock-widget-box {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n}\n\n.digital-clock-face {\n  font-family: 'Courier New', monospace;\n  font-size: 28px;\n  font-weight: 800;\n  color: #34d399;\n  letter-spacing: 2px;\n  background: #020617;\n  padding: 8px 16px;\n  border-radius: 10px;\n  border: 1px solid rgba(16, 185, 129, 0.3);\n  box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);\n}\n\n.punch-action-group {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.btn-punch-in {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: #10b981;\n  color: #ffffff;\n  border: none;\n  padding: 12px 24px;\n  border-radius: 10px;\n  font-size: 14px;\n  font-weight: 700;\n  cursor: pointer;\n  box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);\n  transition: all 0.2s ease;\n}\n\n.btn-punch-in:hover {\n  background: #059669;\n  transform: translateY(-2px);\n}\n\n.btn-punch-out {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: #f59e0b;\n  color: #ffffff;\n  border: none;\n  padding: 12px 24px;\n  border-radius: 10px;\n  font-size: 14px;\n  font-weight: 700;\n  cursor: pointer;\n  box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);\n  transition: all 0.2s ease;\n}\n\n.btn-punch-out:hover {\n  background: #d97706;\n  transform: translateY(-2px);\n}\n\n/* 5. Gradebook & Marks Entry Center */\n.gradebook-toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  flex-wrap: wrap;\n  background: rgba(15, 23, 42, 0.6);\n  padding: 16px 20px;\n  border-radius: 14px;\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  margin-bottom: 20px;\n}\n\n.gradebook-selectors {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n\n.gradebook-selector-item {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.gradebook-selector-item label {\n  font-size: 11px;\n  font-weight: 700;\n  color: #94a3b8;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.gradebook-selector-item select,\n.gradebook-selector-item input {\n  background: #0f172a;\n  border: 1px solid #334155;\n  color: #f8fafc;\n  padding: 7px 12px;\n  border-radius: 8px;\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.marks-input-cell {\n  width: 90px;\n  background: #0f172a;\n  border: 1px solid #334155;\n  color: #38bdf8;\n  padding: 6px 10px;\n  border-radius: 6px;\n  font-weight: 700;\n  font-size: 14px;\n  text-align: center;\n}\n\n.marks-input-cell:focus {\n  border-color: #38bdf8;\n  box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);\n  outline: none;\n}\n\n.remarks-input-cell {\n  width: 100%;\n  min-width: 200px;\n  background: #0f172a;\n  border: 1px solid #334155;\n  color: #f8fafc;\n  padding: 6px 12px;\n  border-radius: 6px;\n  font-size: 12.5px;\n}\n\n.excel-dropzone-box {\n  border: 2px dashed rgba(56, 189, 248, 0.4);\n  background: rgba(15, 23, 42, 0.6);\n  border-radius: 16px;\n  padding: 36px 20px;\n  text-align: center;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  margin-bottom: 24px;\n}\n\n.excel-dropzone-box:hover {\n  border-color: #38bdf8;\n  background: rgba(56, 189, 248, 0.05);\n}\n\n.excel-template-bar {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 12px;\n  margin-bottom: 16px;\n}\n\n/* ==========================================================================\n   EXAM TERMS & 10-ASSESSMENT HISTORICAL GRADE TRACKING\n   ========================================================================== */\n.exam-term-toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 16px;\n  background: rgba(1