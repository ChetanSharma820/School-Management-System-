: center;\n  gap: 8px;\n  margin-top: 18px;\n  padding: 10px 14px;\n  background: rgba(15, 23, 42, 0.6);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  border-radius: 10px;\n  font-size: 12px;\n  color: #94a3b8;\n  text-align: center;\n}\n\n.login-security-tip strong {\n  color: #f1f5f9;\n  font-family: monospace;\n}\n\n/* ==========================================================================\n   ROLE PORTALS (STUDENT & TEACHER WORKSPACES)\n   ========================================================================== */\n.portal-container {\n  min-height: 100vh;\n  background: #090d16;\n  color: #f8fafc;\n  display: flex;\n  flex-direction: column;\n}\n\n.portal-header {\n  padding: 16px 36px;\n  background: rgba(17, 24, 39, 0.9);\n  backdrop-filter: blur(16px);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  position: sticky;\n  top: 0;\n  z-index: 50;\n}\n\n.portal-brand {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.portal-logo {\n  width: 44px;\n  height: 44px;\n  border-radius: 12px;\n  background: rgba(56, 189, 248, 0.12);\n  border: 1px solid rgba(56, 189, 248, 0.3);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.portal-title {\n  font-size: 18px;\n  font-weight: 700;\n  color: white;\n}\n\n.portal-subtitle {\n  font-size: 12px;\n  color: #94a3b8;\n}\n\n.portal-user-profile {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n}\n\n.user-badge-info {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 2px;\n}\n\n.user-fullname {\n  font-size: 14px;\n  font-weight: 700;\n  color: white;\n}\n\n.user-role-tag {\n  font-size: 11px;\n  font-family: monospace;\n  padding: 2px 8px;\n  border-radius: 6px;\n}\n\n.student-tag {\n  background: rgba(56, 189, 248, 0.15);\n  color: #38bdf8;\n  border: 1px solid rgba(56, 189, 248, 0.3);\n}\n\n.teacher-tag {\n  background: rgba(16, 185, 129, 0.15);\n  color: #34d399;\n  border: 1px solid rgba(16, 185, 129, 0.3);\n}\n\n.portal-logout-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 8px 14px;\n  background: rgba(239, 68, 68, 0.12);\n  border: 1px solid rgba(239, 68, 68, 0.35);\n  color: #fca5a5;\n  border-radius: 8px;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.portal-logout-btn:hover {\n  background: rgba(239, 68, 68, 0.25);\n  color: white;\n}\n\n.portal-hero-strip {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 20px;\n  padding: 24px 36px;\n}\n\n.student-metric-card {\n  background: rgba(17, 24, 39, 0.7);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 16px;\n  padding: 20px;\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);\n}\n\n.student-metric-card .metric-icon {\n  width: 52px;\n  height: 52px;\n  border-radius: 14px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.student-metric-card .metric-details {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  min-width: 0;\n}\n\n.student-metric-card .metric-label {\n  font-size: 11px;\n  color: #94a3b8;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  font-weight: 600;\n  display: block;\n}\n\n.student-metric-card .metric-value {\n  font-size: 22px;\n  font-weight: 800;\n  color: white;\n  margin: 4px 0 2px 0;\n}\n\n.student-metric-card .metric-sub {\n  font-size: 12px;\n  color: #64748b;\n}\n\n.portal-nav-tabs {\n  display: flex;\n  gap: 10px;\n  padding: 0 36px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n  background: rgba(15, 23, 42, 0.4);\n  overflow-x: auto;\n}\n\n.portal-tab-btn {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 14px 20px;\n  background: transparent;\n  border: none;\n  border-bottom: 2px solid transparent;\n  color: #94a3b8;\n  font-size: 14px;\n  font-we